# Optional OpenWeatherMap integration
OPENWEATHER_API_KEY=replace_with_your_openweathermap_key

# Optional SMTP integration. Use a test account or an app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_test_account@example.com
SMTP_PASSWORD=replace_with_app_password
SMTP_FROM=your_test_account@example.com
